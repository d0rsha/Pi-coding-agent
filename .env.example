# Separate Git checkout of the Home Assistant configuration repository.
# Never point this at the live Home Assistant /config directory.
HA_REPO=/path/to/home-assistant-config-checkout

# Override only if the Pi package name changes upstream.
PI_PACKAGE=@mariozechner/pi-coding-agent

GIT_AUTHOR_NAME=Pi HA Agent
GIT_AUTHOR_EMAIL=pi-ha-agent@localhost

# Set provider credentials in your shell or secret manager, not in this file.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional: token with only the repository permissions required for branch/PR work.
# Prefer a fine-grained token or GitHub App credential with minimum scope.
# GITHUB_TOKEN=
